<?xml version="1.0" encoding="UTF-8"?>
<tc-config xmlns="http://www.terracotta.org/config"
           xmlns:ohr="http://www.terracotta.org/config/offheap-resource">
  <!--
    Konfiguracja serwera Terracotta dla Mercury DB. Nazwy zasobów i serwera muszą zgadzać się z ehcacheCommon.xml i
    ehcacheDefault.xml w Mercury: serwer "default-server" na porcie 9510, zasób "primary-server-resource".
    Rozmiary zasobów to pamięć OFF-HEAP serwera: suma clustered-dedicated wszystkich pamięci musi się w nich zmieścić.
    Zmiana rozmiaru clustered-dedicated pamięci, która już istnieje na serwerze, jest odrzucana (trzeba najpierw
    usunąć pamięć z serwera albo wyczyścić jego dane).
  -->
  <plugins>
    <config>
      <ohr:offheap-resources>
        <ohr:resource name="primary-server-resource" unit="MB">1024</ohr:resource>
        <ohr:resource name="secondary-server-resource" unit="MB">96</ohr:resource>
      </ohr:offheap-resources>
    </config>
  </plugins>
  <servers>
    <server host="%i" name="default-server">
      <logs>/data/logs</logs>
      <tsa-port bind="0.0.0.0">9510</tsa-port>
      <tsa-group-port bind="0.0.0.0">9530</tsa-group-port>
    </server>
    <client-reconnect-window>120</client-reconnect-window>
  </servers>
</tc-config>
