	xmlns:terracotta='http://www.ehcache.org/v3/clustered'
	xmlns:eh='http://www.ehcache.org/v3'
	xmlns:jsr107='http://www.ehcache.org/v3/jsr107'
	xsi:schemaLocation="
        http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.5.xsd
        http://www.ehcache.org/v3/clustered http://www.ehcache.org/schema/ehcache-clustered-ext-3.5.xsd
        http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext-3.3.xsd">

	<eh:service>
		<terracotta:cluster>
			<terracotta:connection
			        url="terracotta://EHCACHE_TERRACOTA_CONNECTION" />
			<terracotta:server-side-config
				auto-create="true">
				<terracotta:default-resource from="primary-server-resource" />
			</terracotta:server-side-config>
		</terracotta:cluster>
	</eh:service>

	<eh:cache-template name="default">
		<eh:key-type>java.lang.String</eh:key-type>
		<eh:value-type>pl.slawas.common.cache.ehcache.Element</eh:value-type>
		<eh:expiry>
			<eh:class>pl.slawas.common.cache.ehcache.CustomExpiryPolicy</eh:class>
		</eh:expiry>
		<eh:heap unit="entries">1000</eh:heap>
		<terracotta:clustered-store consistency="strong"/>
	</eh:cache-template>

	<!-- szablon pamięci wartości słownikowych atrybutów (pamięć na definicję parametru); lokalny. Aby współdzielić w klastrze,
	     dodaj w resources zasób klastrowy (np. clustered-dedicated) i clustered-store: każda pamięć rezerwuje własną pulę -->
	<eh:cache-template name="attribute-values">
		<eh:key-type>java.lang.String</eh:key-type>
		<eh:value-type>pl.slawas.common.cache.ehcache.Element</eh:value-type>
		<eh:expiry>
			<eh:class>pl.slawas.common.cache.ehcache.CustomExpiryPolicy</eh:class>
		</eh:expiry>
		<eh:heap unit="entries">1000</eh:heap>
	</eh:cache-template>

