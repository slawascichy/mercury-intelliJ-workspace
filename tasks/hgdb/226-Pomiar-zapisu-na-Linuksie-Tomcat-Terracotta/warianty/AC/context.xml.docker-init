<!-- The contents of this file will be loaded for each web application -->
<Context>

	<!-- Default set of monitored resources. If one of these changes, the -->
	<!-- web application will be reloaded. -->
	<WatchedResource>WEB-INF/web.xml</WatchedResource>
	<WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>
	<JarScanner scanManifest="false"/>
	
	<!-- Uncomment this to disable session persistence across Tomcat restarts -->
	<!-- <Manager pathname="" /> -->

	<!-- Uncomment this to enable Comet connection tacking (provides events 
		on session expiration as well as webapp lifecycle) -->
	<!-- <Valve className="org.apache.catalina.valves.CometConnectionManagerValve" 
		/> -->

	<!-- podstawowe źródło danych -->
 	<Resource name="jdbc/MercuryDB" auth="Container" type="javax.sql.DataSource"
		driverClassName="org.postgresql.Driver" url="jdbc:postgresql://POSTGRESQL_CONNECTION/mercury-db"
		username="POSTGRESQL_USER" password="POSTGRESQL_PASSWD" maxTotal="140" maxIdle="100"
		minIdle="30" maxWaitMillis="1200000" defaultAutoCommit="false" />

	<!-- źródło danych elementów wspólnych -->
	<Resource name="jdbc/MercuryDBCommon" auth="Container" type="javax.sql.DataSource"
		driverClassName="org.postgresql.Driver" url="jdbc:postgresql://POSTGRESQL_CONNECTION/mercury-common"
		username="POSTGRESQL_USER" password="POSTGRESQL_PASSWD" maxTotal="40" maxIdle="10"
		minIdle="5" maxWaitMillis="1200000" defaultAutoCommit="false" />

	<!-- źródło danych dla mechanizmów uwierzytelniania -->
	<Resource name="jdbc/MercuryLdapDBPoSql" auth="Container" type="javax.sql.DataSource"
		driverClassName="org.postgresql.Driver" url="jdbc:postgresql://POSTGRESQL_CONNECTION/mercury-ldap"
		username="POSTGRESQL_USER" password="POSTGRESQL_PASSWD" maxTotal="20" maxIdle="5"
		minIdle="1" minEvictableIdleTimeMillis="6000" removeAbandonedOnBorrow="true"
		removeAbandonedTimeout="60" maxWaitMillis="1200000" logAbandoned="true" />

	<!-- źródło danych dla kolejki ActiveMQ -->
	<Resource name="jms/ConnectionFactory" auth="Container" type="org.apache.activemq.ActiveMQConnectionFactory" description="JMS Connection Factory"
	        factory="org.apache.activemq.jndi.JNDIReferenceFactory" brokerURL="tcp://ACTIVEMQ_TCP_CONNECTION" brokerName="LocalActiveMQBroker"/>


</Context>
